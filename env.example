# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

PORT=3000

# Required. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Gnani speech APIs (speech to text and text to speech)
GNANI_API_KEY=

# Google Gemini (conversation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Speech settings (check Gnani docs for the options available on your account)
STT_LANG=en-IN
TTS_LANG=en-IN
TTS_VOICE=Nalini
TTS_MODEL=timbre-v2.5

# Shown to the user if they seem to be in danger. Set this to a helpline for your region.
CRISIS_LINE=
